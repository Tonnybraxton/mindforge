# Local Node development: copy this file to .env, set DATABASE_URL for PostgreSQL,
# then run the migration and seed commands documented in README.md.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://mindforge:mindforge_local@localhost:5432/mindforge?schema=public
# For disposable local account development only; ignored/rejected in production.
MEMORY_DATABASE=false
# Replace before use outside local development (at least 32 characters).
ACCESS_TOKEN_SECRET=local-development-only-replace-with-a-random-secret

# Docker Compose defaults are local HTTP on http://localhost:8080.
# For an HTTPS deployment, set APP_ENV=production and PUBLIC_ORIGIN to its exact
# https:// origin. Terminate TLS at a trusted reverse proxy in front of web:80.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080
POSTGRES_PASSWORD=mindforge_local

# Reserved for future shared cache/rate-limit integration. Current code does not
# consume Redis. `docker compose --profile cache up -d redis` starts it locally.
# REDIS_URL=redis://redis:6379

# OAuth and email delivery are not configured by this implementation. Refresh
# tokens are random, hashed server-side records, so no refresh signing key is used.
